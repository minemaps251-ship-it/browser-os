{
  "name": "browseros-editor-spike",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../node_modules/vite/bin/vite.js build",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "measure": "node measure.mjs",
    "preview": "node ../../node_modules/vite/bin/vite.js preview --host 127.0.0.1 --port 4175 --strictPort",
    "lint": "node ../../node_modules/eslint/bin/eslint.js --config eslint.config.mjs *.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "monaco-editor": "0.57.0"
  }
}
